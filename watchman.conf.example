# Watchman Configuration
#
# !! REVIEW BEFORE USE !!
# This file was copied from watchman.conf.example during setup.
# At minimum, check the following before starting the service:
#
#   1. ARCHIVE_DIR  — must point to a directory owned by the user running Watchman.
#                     setup.sh auto-fills this and SERVICE_USER based on whoever
#                     ran it via sudo, so this is usually already correct.
#
#   2. PUSHOVER_TOKEN / PUSHOVER_USER  — required if NOTIFY_ENABLED=yes.
#                     Get your credentials at https://pushover.net
#
#   3. NOTIFY_ENABLED — set to "no" if you don't want push notifications.

# ── GhostDrive ──────────────────────────────────────────────

# Path to the virtual disk container
CONTAINER=/ghostdrive.bin

# Size in MB (only used by create_disk.sh, 6144 = 6GB)
CONTAINER_SIZE_MB=6144

# Where to temporarily mount the container for file transfer
MOUNT_POINT=/mnt/ghostdrive

# ── Archive ─────────────────────────────────────────────────

# Where videos are permanently stored.
# Auto-filled by setup.sh based on whoever ran it via sudo — you normally
# don't need to change this by hand (see SERVICE_USER below).
ARCHIVE_DIR=/home/watchman/archive

# System user the web service runs as, and that archived files get
# chowned to (so the non-root web UI can delete/manage them).
# setup.sh auto-detects and fills this in based on whoever ran it via
# sudo — you normally don't need to touch this by hand.
SERVICE_USER=watchman

# ── USB Gadget ──────────────────────────────────────────────

# Kernel module for USB mass storage
GADGET_MODULE=g_mass_storage

# Where WiFi/connectivity snapshots get logged (JSON lines) around each
# write-detected/ingest event. watchman.service runs as root, so this
# lives under /var/log rather than any particular user's home directory.
CONNECTIVITY_LOG=/var/log/watchman/connectivity.jsonl

# ── Timing ──────────────────────────────────────────────────

# Seconds to wait after last write before ingesting
SETTLE_TIME=120

# Minimum seconds between ingest cycles
MIN_INTERVAL=1800

# Seconds to ignore writes after the gadget reconnects
# (prevents Blink's post-reconnect filesystem activity from triggering
# a new cycle immediately)
RECONNECT_COOLDOWN=120

# ── Watchdog ────────────────────────────────────────────────

# Consecutive failures before attempting full USB reset
WATCHDOG_THRESHOLD=3

# ── Web Interface ───────────────────────────────────────────

WEB_HOST=0.0.0.0
WEB_PORT=5000

# ── Retention / Auto Cleanup ───────────────────────────────────────────────

# off     = keep everything
# archive = move old clips from ARCHIVE_DIR to RETENTION_ARCHIVE_DIR
# delete  = permanently remove old clips from ARCHIVE_DIR
RETENTION_MODE=off

# Clips older than this number of days are processed by retention mode
RETENTION_DAYS=30

# Destination folder used only when RETENTION_MODE=archive
RETENTION_ARCHIVE_DIR=

# Minimum seconds between automatic retention runs in web.py
RETENTION_RUN_INTERVAL=3600

# ── Nextcloud Sync ──────────────────────────────────────────────────────────

# When "yes" and RETENTION_MODE=delete, each date folder is uploaded to
# Nextcloud (via rclone) and verified before it's allowed to be deleted.
# Uses the same year/month/day folder naming the archive already uses;
# rclone creates matching folders on Nextcloud automatically if missing.
# If a folder can't be verified as uploaded, it's skipped and retried on
# the next retention run — nothing is deleted until it's confirmed offsite.
NEXTCLOUD_ENABLED=no

# rclone remote:path — must already be configured via `rclone config`
# e.g. nextcloud:Watchman  (see README for setup)
NEXTCLOUD_REMOTE=

# Path to the rclone binary (just "rclone" if it's already on PATH)
NEXTCLOUD_RCLONE_PATH=rclone

# ── Network Watchdog ─────────────────────────────────────────────────────────

# Set to "no" to disable without removing the service
NET_WATCHDOG_ENABLED=yes

# Host to ping to check connectivity
NET_WATCHDOG_HOST=8.8.8.8

# How long (seconds) connectivity must be lost before rebooting (default: 5 min)
NET_WATCHDOG_TIMEOUT=600

# How often (seconds) to check connectivity
NET_WATCHDOG_INTERVAL=300

# ── Notifications (Pushover) ─────────────────────────────────────────────────
#
# When enabled, notifications are sent for:
#   - Clips successfully ingested from Blink
#   - Ingest cycle failures, and USB gadget watchdog resets
#   - Retention cleanup runs (files deleted/archived, or errors)
#   - Nextcloud upload/verification failures

# Set to "no" to disable notifications
NOTIFY_ENABLED=yes

# Pushover application API token (from https://pushover.net/apps)
PUSHOVER_TOKEN=your_app_token_here

# Pushover user key (from https://pushover.net)
PUSHOVER_USER=your_user_key_here

# ── Video Playback ────────────────────────────────────────────────────────────
#
# Controls how much of each clip the browser loads before you press play.
#   none     = load nothing until play is pressed (default, safest)
#   metadata = browser fetches duration/dimensions for every visible clip
#   auto     = browser may preload the full video for every visible clip
# With many clips on one page, "metadata" or "auto" can trigger a burst of
# simultaneous requests — this has caused real crashes on underpowered
# setups (e.g. a UPS HAT running below its rated cell count). Only change
# this if you understand that tradeoff. Also editable from the web UI's
# Settings page.
VIDEO_PRELOAD=none
